# Plans, specs, scratch and review renders: local only, never committed and never deployed.
# The Worker deploys only its bundled code and the static assets directory, which artifacts/ is not part of.
/artifacts/
# The deployed site, built by scripts/site.mjs at deploy time: komorebi's static site with public/ under arboretum/.
/.site/
/.site.tmp/
/node_modules/
/.wrangler/
/.dev.vars*
# What scripts/engine.mjs generates from the komorebi beside arboretum, before tests, typecheck and the dev mode.
/src/generated/
/test/fixtures/looks.json
/public/engine/
